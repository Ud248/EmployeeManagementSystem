<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>InsertDepartment</servlet-name>
        <servlet-class>Controller.InsertDepartment</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ShowDepartment</servlet-name>
        <servlet-class>Controller.ShowDepartment</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Welcome</servlet-name>
        <servlet-class>Controller.Welcome</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ShowProject</servlet-name>
        <servlet-class>Controller.ShowProject</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ShowEmployee</servlet-name>
        <servlet-class>Controller.ShowEmployee</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InsertDepartment</servlet-name>
        <url-pattern>/insert-department</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShowDepartment</servlet-name>
        <url-pattern>/show-department</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Welcome</servlet-name>
        <url-pattern>/welcome</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShowProject</servlet-name>
        <url-pattern>/show-project</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShowEmployee</servlet-name>
        <url-pattern>/show-employee</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>Controller.Login</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ViewDepartment</servlet-name>
        <servlet-class>Controller.ViewDepartment</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewDepartment</servlet-name>
        <url-pattern>/view-department</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteDepartment</servlet-name>
        <url-pattern>/delete-department</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>DeleteDepartment</servlet-name>
        <servlet-class>Controller.DeleteDepartment</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateDepartment</servlet-name>
        <servlet-class>Controller.UpdateDepartment</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateDepartment</servlet-name>
        <url-pattern>/update-department</url-pattern>
    </servlet-mapping>
    
    <welcome-file-list>
        <welcome-file>welcome</welcome-file>
    </welcome-file-list>
    
    <session-config>
        <session-timeout>2</session-timeout>
    </session-config>
    
    <listener>
        <listener-class>listenner.InitProjectData</listener-class>
    </listener>
</web-app>
